{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ma classe",
  "version": "5.0.0",
  "identifier": "fr.franckvarault.maclasse",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ma classe",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://harry-safe.github.io data: blob:",
        "worker-src": "'self' blob:",
        "frame-src": "'self' blob: https: http: appli:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Franck VARAULT",
    "copyright": "© 2026 Franck VARAULT",
    "category": "Education",
    "shortDescription": "Ma classe",
    "longDescription": "Ma classe : la journée, les rituels, les tableaux et les outils de la classe de CP. Conçu par Franck VARAULT.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": false
  }
}
